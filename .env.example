# CURRENT_BACKEND=Firebase. These browser-safe identifiers are not secrets;
# access is enforced by Firebase Auth, Security Rules and server authorization.
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-web-app-id

# Server-only Firebase Admin credentials. Preserve escaped newlines in Vercel.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY='-----BEGIN PRIVATE KEY-----\nreplace-with-real-key\n-----END PRIVATE KEY-----\n'

# Canonical Vercel/public origin used for safe redirects and email actions.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local Emulator Suite. Uncomment all three only for emulator work.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Transactional email provider is intentionally deferred until configured.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Bufete Legal <no-reply@example.com>
