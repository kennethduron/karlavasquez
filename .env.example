# Browser-safe Supabase settings. The anon key is intentionally public and is
# still constrained by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never prefix this value with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical public origin used for metadata, redirects and email links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transactional email (future phase).
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Bufete Legal <no-reply@example.com>

# Optional server-side rate-limit provider (future phase).
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
