# PUBLIC — browser-visible configuration. Values are intentionally blank.
NEXT_PUBLIC_SITE_URL=

# PUBLIC — Firebase is used only for FCM Web Push.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PUBLIC — FCM Web Push certificate.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# PUBLIC — authoritative Supabase browser configuration.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER_ONLY — Firebase Admin Messaging only. Never expose in client bundles.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SERVER_ONLY — Supabase privileged access; never use NEXT_PUBLIC_ here.
SUPABASE_SECRET_KEY=
# Optional database tooling only. Leave blank until a tool requires it.
SUPABASE_DB_URL=

# SERVER_ONLY — transactional email. Sender values remain blank until approved.
RESEND_API_KEY=
RESEND_FROM_NAME=
RESEND_FROM_EMAIL=

# SERVER_ONLY — public marketing media administration. The cloud name may be
# exposed separately in Phase 2.4B only if a browser integration requires it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SERVER_ONLY — private offsite backups.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=
