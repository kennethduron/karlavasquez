# PUBLIC — browser-visible configuration. Values are intentionally blank.
NEXT_PUBLIC_SITE_URL=

# PUBLIC — Firebase remains the active Auth/Firestore runtime in Phase 2.4A.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# PUBLIC — staged FCM Web Push certificate; runtime integration is Phase 2.4B.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# PUBLIC — staged Supabase browser configuration; not active until Phase 2.4B.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER_ONLY — Firebase Admin remains active during Phase 2.4A.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# SERVER_ONLY — staged Supabase privileged access; never use NEXT_PUBLIC_ here.
SUPABASE_SERVICE_ROLE_KEY=
# Optional database tooling only. Leave blank until a tool requires it.
SUPABASE_DB_URL=

# SERVER_ONLY — transactional email. Sender values remain blank until approved.
RESEND_API_KEY=
RESEND_FROM_NAME=
RESEND_FROM_EMAIL=

# SERVER_ONLY — public marketing media administration. The cloud name may be
# exposed separately in Phase 2.4B only if a browser integration requires it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SERVER_ONLY — private offsite backups.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_ENDPOINT=
B2_REGION=

# DEVELOPMENT_ONLY — uncomment only for local Firebase Emulator Suite work.
# NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
# FIREBASE_AUTH_EMULATOR_HOST=
# FIRESTORE_EMULATOR_HOST=
