rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }
    function currentUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    function active() {
      return signedIn() && currentUser().status == 'active';
    }
    function hasPermission(permission) {
      return active() &&
        (permission in currentUser().effectivePermissions ||
          '*' in currentUser().effectivePermissions);
    }
    function canAccessCase(caseId) {
      let legalCase = firestore.get(/databases/(default)/documents/cases/$(caseId)).data;
      return hasPermission('cases.view') &&
        (hasPermission('cases.view_all') ||
          legalCase.responsibleUserId == request.auth.uid ||
          request.auth.uid in legalCase.assignedUserIds);
    }
    function documentMatchesCase(caseId, documentId) {
      let document = firestore.get(/databases/(default)/documents/documents/$(documentId)).data;
      return document.caseId == caseId;
    }
    function safeTechnicalIds(caseId, documentId, versionId) {
      return caseId.matches('^[A-Za-z0-9_-]{6,128}$') &&
        documentId.matches('^[A-Za-z0-9_-]{6,128}$') &&
        versionId.matches('^[A-Za-z0-9_-]{2,128}$');
    }
    function acceptedType() {
      return request.resource.contentType.matches('application/pdf') ||
        request.resource.contentType.matches('image/jpeg') ||
        request.resource.contentType.matches('image/png') ||
        request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document');
    }

    match /private-legal-documents/{caseId}/{documentId}/{versionId} {
      allow read: if safeTechnicalIds(caseId, documentId, versionId) &&
        hasPermission('documents.view') && canAccessCase(caseId) &&
        documentMatchesCase(caseId, documentId);
      allow create: if safeTechnicalIds(caseId, documentId, versionId) &&
        hasPermission('documents.upload') && canAccessCase(caseId) &&
        documentMatchesCase(caseId, documentId) &&
        request.resource.size > 0 && request.resource.size <= 25 * 1024 * 1024 &&
        acceptedType() &&
        request.resource.metadata.caseId == caseId &&
        request.resource.metadata.documentId == documentId;
      allow update: if false;
      allow delete: if safeTechnicalIds(caseId, documentId, versionId) &&
        hasPermission('documents.manage') && canAccessCase(caseId) &&
        documentMatchesCase(caseId, documentId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
