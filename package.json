{
  "name": "karla-norin-vasquez-legal-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets:brand": "node scripts/generate-brand-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:remote": "playwright test tests/e2e/public-site.spec.ts",
    "test:supabase:auth": "node --env-file=.env.local scripts/supabase-auth-smoke.mjs",
    "test:supabase:storage": "node --env-file=.env.local scripts/supabase-storage-smoke.mjs",
    "test:fcm:subscriptions": "node --env-file=.env.local scripts/fcm-subscription-boundary-smoke.mjs",
    "test:fcm:connectivity": "node --env-file=.env.local scripts/firebase-messaging-connectivity.mjs",
    "test:supabase:rls": "supabase test db supabase/tests/rls_attack_tests.sql",
    "supabase:lint": "supabase db lint --local --level warning",
    "test:providers": "node --env-file-if-exists=.env.local scripts/provider-connectivity-check.mjs",
    "test:resend:production": "node scripts/resend-production-smoke.mjs --confirm-phase-smoke",
    "security:check": "node scripts/security-check.mjs",
    "quality": "npm run typecheck && npm run lint && npm run test && npm run security:check && npm run build"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "gaxios": "7.3.1",
    "uuid": "11.1.1",
    "firebase-admin": {
      "jwks-rsa": {
        "jose": "4.15.9"
      }
    }
  }
}
